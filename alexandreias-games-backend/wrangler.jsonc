{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "alexandreias-games-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-15",
	"assets": {
		"directory": "../alexandreias-games-frontend/dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"env": {
		"staging": {
			"vars": {
				"ENVIRONMENT": "staging"
			}
		},
		"production": {
			"vars": {
				"ENVIRONMENT": "production"
			}
		}
	}
	// "d1_databases": [
	// 	{
	// 		"binding": "DB",
	// 		"database_name": "",
	// 		"database_id": ""
	// 	}
	// ]
}